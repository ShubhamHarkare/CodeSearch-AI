# Everything the image doesn't need. Smaller build context = faster builds, and
# secrets can't end up in an image layer by accident.

# secrets and local settings
.env
.env.*
!.env.example

# big local data: the index and corpus are volumes, built inside the stack
data/
index/
traces/
results/
mlruns/
mlflow.db
logs/

# not needed at runtime
.git/
.github/
.venv/
tests/
docs/
legacy/
deploy/grafana/
**/__pycache__/
**/*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.DS_Store
