# Patterns starting with "/" only match at the repo root. Without it, "index/"
# would also hide codesearch/index/ (the source package).

# Secrets and local environments
.env
.venv/

# Runtime outputs (never committed)
/data/
/index/
/mlruns/
/results/
/logs/
*.db

# v1 leftovers kept locally
/react_db/
/consolidated_react_docs.md
/output*.txt
test_results*.json
test_metrics*.json

# Tool caches
__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.DS_Store
