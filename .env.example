# LLM
GROQ_API_KEY=
CODESEARCH_LLM__PROVIDER=groq          # groq | ollama | fake
CODESEARCH_LLM__MODEL=llama-3.1-8b-instant
# Cache
REDIS_URL=redis://localhost:6379/0
# Index
CODESEARCH_INDEX__REACT_DEV_SHA=       # pinned react.dev commit
# Admin
REINDEX_WEBHOOK_SECRET=                # HMAC secret for POST /v1/admin/reindex
