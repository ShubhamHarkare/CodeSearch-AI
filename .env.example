# Every environment variable CodeSearch AI reads. Copy to .env and edit.
# All names start with CODESEARCH_; nested settings use a double underscore
# (CODESEARCH_CACHE__REDIS_URL sets settings.cache.redis_url). Names without the
# prefix are ignored. Defaults live in codesearch/config.py; a line left
# commented out keeps its default. Never put real secrets in this file.

# LLM
CODESEARCH_LLM__PROVIDER=ollama        # ollama | fake (fake = canned answers, no model)
CODESEARCH_LLM__MODEL=gemma3:4b        # any model you've pulled: ollama pull gemma3:4b
CODESEARCH_LLM__OLLAMA_BASE_URL=http://localhost:11434

# Cache (without Redis running, the exact cache falls back to memory)
CODESEARCH_CACHE__REDIS_URL=redis://localhost:6379/0

# Index: the react.dev commit is pinned in config.py; override only to re-pin.
# An empty value would override the pin, so leave this commented out.
# CODESEARCH_INDEX__REACT_DEV_SHA=<40-character commit sha>

# Admin
# CODESEARCH_ADMIN__WEBHOOK_SECRET=<random string>   # HMAC secret for POST /v1/admin/reindex
